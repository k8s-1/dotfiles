[pull]
	rebase = true
[commit]
	gpgsign = true
[tag]
	gpgsign = true
# HOW TO CREATE A GPG SIGNING KEY:
#
#   1. gpg --full-generate-key
#        (RSA, 4096 bits, no expiry, use same email as user.email above)
#
#   2. Get the <KEY_ID>
#        gpg --list-secret-keys
#        (copy the 16-char hex ID)
#
#   3. git config --global user.signingkey <KEY_ID>
#
#   4. Export public key to GitHub/GitLab:
#        gpg --armor --export <KEY_ID>
#        (paste into GitHub → Settings → SSH and GPG keys → New GPG key)
